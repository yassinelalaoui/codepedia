<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ title }}</title>
<style>
  body { font-family: -apple-system, Segoe UI, Helvetica, Arial, sans-serif; max-width: 60rem; margin: 0 auto; padding: 1.5rem; line-height: 1.55; color: #1a1a1a; }
  header.site-header { border-bottom: 1px solid #ddd; margin-bottom: 1.5rem; padding-bottom: 0.5rem; }
  header.site-header a { text-decoration: none; color: #0b5fff; }
  footer.site-footer { border-top: 1px solid #ddd; margin-top: 2rem; padding-top: 0.5rem; color: #666; font-size: 0.85rem; }
  pre { background: #f6f8fa; padding: 0.75rem; overflow-x: auto; }
  code { background: #f6f8fa; padding: 0.1rem 0.3rem; }
  table { border-collapse: collapse; }
  th, td { border: 1px solid #ddd; padding: 0.4rem 0.6rem; }
</style>
</head>
<body>
<header class="site-header">
  <nav><a href="{{ home_href }}">Home</a></nav>
</header>
<main>
{{ content_html | safe }}
</main>
<footer class="site-footer">
  <p>Generated locally by doc_generator on {{ generated_at }}.</p>
</footer>
</body>
</html>