<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<link rel="stylesheet" href="{{ ui_style_href }}">
</head>
<body>
<div class="shell">
  <nav class="sidebar" aria-label="Repository navigation">
    <a class="brand" href="{{ home_href }}">
      <span class="brand-mark" aria-hidden="true">CP</span>
      <span class="brand-name">codepedia</span>
    </a>
    <div id="wiki-search-root"></div>
    <div id="wiki-toc-root"></div>
{% if page_toc %}
    <div class="nav-group page-toc">
      <div class="nav-label">On this page</div>
{% for section in page_toc %}
      <a class="page-toc-link" href="#{{ section.id }}">{{ section.name }}</a>
{% for child in section.children %}
      <a class="page-toc-link child" href="#{{ child.id }}">{{ child.name }}</a>
{% endfor %}
{% endfor %}
    </div>
{% endif %}
    <div class="nav-group">
      <a class="nav-link" href="{{ home_href }}">
        <svg class="nav-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 11l9-7 9 7"/><path d="M5 10v9a1 1 0 0 0 1 1h4v-6h4v6h4a1 1 0 0 0 1-1v-9"/></svg>
        Home
      </a>
      <a class="nav-link{{ ' active' if is_diagrams_page else '' }}" href="{{ diagrams_href }}">
        <svg class="nav-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
        Diagrams
      </a>
    </div>
    {% if nav_features %}
    <div class="nav-group">
      <div class="nav-label">Features</div>
      {# A flat list, not a <details> tree. The sidebar answers "what does this
         repository do"; every module is still reachable from its feature page,
         which lists all of them, and from search, which indexes all of them. #}
      {% for feature in nav_features %}
      <a class="nav-link feature{{ ' active' if feature.active else '' }}" href="{{ feature.href }}">{{ feature.title }}</a>
      {% endfor %}
    </div>
    {% endif %}
  </nav>

  <main class="main">
    <div class="content-col">
{{ content_html | safe }}
    </div>
    <footer class="site-footer">
      <p>Generated locally by doc_generator on {{ generated_at }}{% if commit_sha %} · Commit <code class="commit-sha" title="{{ commit_sha }}">{{ commit_sha_short }}</code>{% endif %}.</p>
    </footer>
  </main>

  <div id="wiki-chat-root"></div>
</div>
<script src="{{ mermaid_script_href }}"></script>
<script>
  // `startOnLoad: false` plus an explicit `mermaid.run()`: auto-render-on-load
  // offers no completion signal, and the wiki UI's pan/zoom enhancer has to
  // attach after the SVG exists. `run()` returns a promise, which is that
  // signal. `suppressErrors` keeps one unparseable diagram from aborting the
  // batch, and the dispatch sits in `finally` so the enhancer still runs when
  // the batch rejects. Deliberately inline rather than inside wiki-ui.js: a
  // bundle that fails to load must cost the zoom, never the diagram itself.
  if (window.mermaid) {
    // `querySelector` MUST be passed explicitly. Mermaid 10's `run()` only
    // applies its own '.mermaid' default when called with no arguments at all;
    // passing any options object drops it and the call rejects with "Nodes and
    // querySelector are both undefined" - which `suppressErrors` then swallows,
    // leaving every diagram on the page as raw fence text and no error anywhere.
    mermaid.initialize({ startOnLoad: false });
    mermaid.run({ querySelector: '.mermaid', suppressErrors: true }).finally(function () {
      document.dispatchEvent(new CustomEvent('wiki:mermaid-rendered'));
    });
  }
</script>
<script>window.__WIKI_UI_CONFIG__ = { searchIndexHref: {{ search_index_href | tojson }} };</script>
<script src="{{ ui_script_href }}"></script>
</body>
</html>
