{# `is_prose` switches the labels for a documentation file (.md), whose symbols
   are headings rather than code. The structure is deliberately shared with the
   code path rather than split into a second template: anchors, section links,
   related links and entry-point links are all identical, and only the words
   around them differ. #}
{# A documentation file usually opens with its own `#` title, which is more
   informative than the filename ("Feature Specification: ..." against "spec").
   Emitting both would put two H1s on the page, so the document's own title
   wins when it has one. `module.name` still drives the sidebar and the output
   path, which is what keeps the page's filename stable when a title is
   reworded - `links.page_slug` is built from it, and a moved path would orphan
   the previously written file since page *ids* key on `sourceFileId`. #}
{% if not (is_prose and module.docstring.lstrip().startswith('# ')) %}
# {{ module.name | mdesc }}

{% endif %}
{% if module.docstring %}{{ module.docstring }}

{% endif %}
{% if section_link %}
[In section: {{ section_link.label | mdesc }}]({{ section_link.relativePath }}){: .section-link }

{% endif %}
## Summary

{% if module.generatedSummary %}
{{ module.generatedSummary }}
{: .ai-generated }

{% if module.summaryIsStale %}
_This summary describes an earlier version of the code and has not been regenerated yet._
{: .summary-stale }

{% endif %}
{% else %}
_Summary pending — this {{ 'document' if is_prose else 'module' }} has not been summarized yet._
{% endif %}

{% if diagram_link %}
[View dependency diagram]({{ diagram_link.relativePath }}){: .diagram-link }
{% endif %}

{# For prose, an empty block is the ordinary case rather than a meaningful
   absence: a document whose `###` headings all sit under a `##` has no
   top-level subsections, and a .md file has no imports, so "Subsections" and
   "Related documents" would be permanently empty. A code module keeps the
   headings unconditionally - "no classes" is information there. #}
{% if classes or not is_prose %}
## {{ 'Sections' if is_prose else 'Classes' }}

{% if classes %}
{% for class, methods in classes %}
### {{ class.name | mdesc }} {: #{{ anchors[class.id] }} data-symbol-id="{{ class.id }}" }

{% if class.parentClass %}Inherits from `{{ class.parentClass }}`.

{% endif %}
{% if class.docstring %}{{ class.docstring }}

{% endif %}
{% if class.generatedSummary %}
{{ class.generatedSummary }}
{: .ai-generated }

{% if class.summaryIsStale %}
_This summary describes an earlier version of the code and has not been regenerated yet._
{: .summary-stale }

{% endif %}
{% else %}
_Summary pending — this {{ 'section' if is_prose else 'class' }} has not been summarized yet._
{% endif %}

{% if methods %}
{% for method in methods %}
{% if is_prose %}
#### {{ method.name | mdesc }} {: #{{ anchors[method.id] }} data-symbol-id="{{ method.id }}" }
{% else %}
#### {{ class.name | mdesc }}.{{ method.name | mdesc }}({{ method.parameters | map(attribute='name') | map('mdesc') | join(', ') }}){% if method.returnType %} -> {{ method.returnType | mdesc }}{% endif %} {: #{{ anchors[method.id] }} data-symbol-id="{{ method.id }}" }
{% endif %}

{% if method.docstring %}{{ method.docstring }}

{% endif %}
{% if method.generatedSummary %}
{{ method.generatedSummary }}
{: .ai-generated }

{% if method.summaryIsStale %}
_This summary describes an earlier version of the code and has not been regenerated yet._
{: .summary-stale }

{% endif %}
{% else %}
_Summary pending — this {{ 'subsection' if is_prose else 'method' }} has not been summarized yet._
{% endif %}

{% if entry_point_links.get(method.id) %}
[View call sequence]({{ entry_point_links[method.id].relativePath }}){: .call-seq-link }
{% endif %}

{% endfor %}
{% endif %}
{% endfor %}
{% else %}
_No classes in this module._
{% endif %}
{% endif %}

{% if functions or not is_prose %}
## {{ 'Subsections' if is_prose else 'Functions' }}

{% if functions %}
{% for function in functions %}
{% if is_prose %}
### {{ function.name | mdesc }} {: #{{ anchors[function.id] }} data-symbol-id="{{ function.id }}" }
{% else %}
### {{ function.name | mdesc }}({{ function.parameters | map(attribute='name') | map('mdesc') | join(', ') }}){% if function.returnType %} -> {{ function.returnType | mdesc }}{% endif %} {: #{{ anchors[function.id] }} data-symbol-id="{{ function.id }}" }
{% endif %}

{% if function.docstring %}{{ function.docstring }}

{% endif %}
{% if function.generatedSummary %}
{{ function.generatedSummary }}
{: .ai-generated }

{% if function.summaryIsStale %}
_This summary describes an earlier version of the code and has not been regenerated yet._
{: .summary-stale }

{% endif %}
{% else %}
_Summary pending — this {{ 'subsection' if is_prose else 'function' }} has not been summarized yet._
{% endif %}

{% if entry_point_links.get(function.id) %}
[View call sequence]({{ entry_point_links[function.id].relativePath }}){: .call-seq-link }
{% endif %}

{% endfor %}
{% else %}
_No functions in this module._
{% endif %}
{% endif %}

{% if related_links or not is_prose %}
## Related {{ 'documents' if is_prose else 'modules' }}

{% if related_links %}
{% for link in related_links %}
- [{{ link.label | mdesc }}]({{ link.relativePath }}){: .related-chip }
{% endfor %}
{% else %}
_No related modules detected._
{% endif %}
{% endif %}
